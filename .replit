# Replit configuration for Nexus-G (AI WebGL game builder).
# The Run button starts the agent loop plus the preview web server.
# Generated games are served from nexus_workspace/ on port 8080.

entrypoint = "main.py"
run = "python3 main.py"

# Nix-based modular environment: pull in a Python interpreter.
modules = ["python-3.11"]

[nix]
channel = "stable-23_11"

# Expose the game preview through Replit's public webview proxy.
[[ports]]
localPort = 8080
externalPort = 80
